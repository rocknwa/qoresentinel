# All keys belong on the server. Keep .env out of Git.
QORE_DATA_DIR=.local-data
QORE_ENABLE_LLM_AUDIT=false
QORE_AUDIT_WORKERS=3
# RiskSearcher provider order: Anthropic -> OpenRouter -> Groq -> AgentRouter
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
AGENTROUTER_API_KEY=
# Optional override if using a custom AgentRouter endpoint:
# AGENTROUTER_URL=https://agentrouter.org
